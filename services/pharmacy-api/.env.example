# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3004

# ─── MongoDB (the pharmacy has its OWN database, separate from ElderCare) ─────
MONGODB_URI=
PHARMACY_DB_NAME=eldercare_pharmacy

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Signs pharmacist login tokens
PHARMACY_JWT_SECRET=
PHARMACY_JWT_EXPIRES_IN=12h
# Key that partner systems (the ElderCare MCP server) send in the X-API-Key header
PHARMACY_API_KEY=

# ─── Seed (pnpm --filter @eldercare/pharmacy-api seed) — dev credentials only ─
PHARMACY_SEED_USERNAME=pharmacist
PHARMACY_SEED_PASSWORD=
