# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/eldercare

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ─── OTP ──────────────────────────────────────────────────────────────────────
OTP_EXPIRES_IN_SECONDS=300
# Set to "true" in development to return OTP in response body (never in prod)
OTP_DEV_MODE=true
