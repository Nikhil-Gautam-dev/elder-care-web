# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3003

# ─── MongoDB (the ElderCare database) ─────────────────────────────────────────
MONGODB_URI=
DB_NAME=

# ─── Pharmacy (independent service) ───────────────────────────────────────────
PHARMACY_API_URL=http://localhost:3004
# Same value as PHARMACY_API_KEY in services/pharmacy-api/.env
PHARMACY_API_KEY=

# ─── Rides (independent service) ──────────────────────────────────────────────
RIDES_API_URL=http://localhost:3005
# Same value as RIDES_API_KEY in services/rides-api/.env
RIDES_API_KEY=
