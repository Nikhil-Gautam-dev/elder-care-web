{
  "name": "@eldercare/mcp",
  "version": "0.0.1",
  "private": true,
  "description": "ElderCare MCP (Model Context Protocol) server — exposes ElderCare tools over Streamable HTTP",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "[ -d src ] && eslint src || echo 'No src/ — skipping lint'",
    "lint:fix": "[ -d src ] && eslint src --fix || echo 'No src/ — skipping lint'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eldercare/eslint-config": "workspace:*",
    "@eldercare/tsconfig": "workspace:*",
    "@eldercare/prettier-config": "workspace:*",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@eldercare/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.4.5",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.8.0",
    "zod": "^3.23.8"
  },
  "prettier": "@eldercare/prettier-config"
}
