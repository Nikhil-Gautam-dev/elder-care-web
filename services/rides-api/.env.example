# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3005

# ─── MongoDB (rides has its OWN database, separate from ElderCare) ────────────
MONGODB_URI=
RIDES_DB_NAME=eldercare_rides

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Signs dispatcher/driver login tokens
RIDES_JWT_SECRET=
RIDES_JWT_EXPIRES_IN=12h
# Key that partner systems (the ElderCare MCP server) send in the X-API-Key header
RIDES_API_KEY=

# ─── Fare estimate (INR). Distance-based when pickup and drop both have lat/lng, else flat ──
RIDES_FARE_BASE=40
RIDES_FARE_PER_KM=14
RIDES_FARE_FLAT=150

# ─── Seed (pnpm --filter @eldercare/rides-api seed) — dev credentials only ────
RIDES_SEED_USERNAME=dispatcher
RIDES_SEED_PASSWORD=
