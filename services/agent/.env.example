# ElderCare Agent Service — Environment Variables
# Copy this file to .env and fill in your values.

# ---------------------------------------------------------------------------
# LLM providers — tried in the order listed. If one hits a rate limit or any
# error, the agent switches to the next immediately and skips the failed one
# for a cooldown. A provider with no API key is disabled; at least one is needed.
# ---------------------------------------------------------------------------

# comma-separated, first = preferred  (default: gemini,groq)
LLM_PROVIDERS=gemini,groq
LLM_TEMPERATURE=0.4

# Groq — https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

PORT=3002

# ---------------------------------------------------------------------------
# MCP server the agent uses for all tools
# ---------------------------------------------------------------------------
MCP_SERVER_URL=http://localhost:3003/mcp

# Must match services/api so the agent can verify user login tokens
JWT_SECRET=
