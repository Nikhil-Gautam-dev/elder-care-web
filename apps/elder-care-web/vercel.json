{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.nikhilgautam.me/elder-care-api/:path*"
    },
    {
      "source": "/agent-api/:path*",
      "destination": "https://api.nikhilgautam.me/elder-care-agent/:path*"
    },
    {
      "source": "/pharmacy-api/:path*",
      "destination": "https://api.nikhilgautam.me/elder-care-pharmacy/:path*"
    },
    {
      "source": "/rides-api/:path*",
      "destination": "https://api.nikhilgautam.me/elder-care-rides/:path*"
    },
    {
      "source": "/mcp-api/:path*",
      "destination": "https://api.nikhilgautam.me/elder-care-mcp/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
