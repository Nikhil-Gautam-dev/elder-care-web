# Strict hoisting — each package resolves its own deps
shamefully-hoist=false

# Automatically install peer dependencies
auto-install-peers=true

# Don't fail hard on peer dep mismatches (common in the ecosystem)
strict-peer-dependencies=false

# Store pnpm cache inside the project (useful for CI layer caching)
# store-dir=.pnpm-store

# Link workspace packages via symlinks (default, explicit)
link-workspace-packages=true

# Always prefer workspace packages over registry
prefer-workspace-packages=true
