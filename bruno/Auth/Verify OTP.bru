meta {
  name: Verify OTP
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/verify-otp
  body: json
  auth: none
}

body:json {
  {
    "phone": "+1234567890",
    "otp": "241404"
  }
}

script:post-response {
  if (res.body && res.body.data && res.body.data.token) {
    bru.setVar("authToken", res.body.data.token);
  }
  if (res.body && res.body.data && res.body.data.user) {
    bru.setVar("userId", res.body.data.user.id);
  }
}
