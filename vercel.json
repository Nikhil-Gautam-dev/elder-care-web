{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/login",
      "dest": "/login.html"
    },
    {
      "src": "/signup",
      "dest": "/login.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    }
  ]
}
